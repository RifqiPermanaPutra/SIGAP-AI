# Dependencies
node_modules/

# Build output
dist/

# Basis data lokal (berisi sesi & data pelapor — jangan diunggah).
# Garis miring di depan membatasi pola ini pada folder data/ di akar proyek
# saja. Tanpa itu, folder src/data/ yang berisi kode ikut terabaikan.
/data/

# Berkas SQLite beserta berkas pendampingnya (-wal, -shm), berjaga-jaga bila
# DB_PATH diarahkan ke luar folder data/. Isinya nama pegawai asli.
*.db
*.db-wal
*.db-shm

# Environment — RAHASIA. Berisi API key. JANGAN pernah di-commit.
.env
.env.local
.env.*.local

# Log
*.log
npm-debug.log*

# File scratch / uji coba
_*.mjs
_*.js
_*.sh
_*.log

# Konfigurasi editor & alat bantu
.vscode/
.idea/
.claude/
.qodo/

# Dokumentasi laporan — tangkapan layar, diagram, dan presentasi.
# Dipindahkan keluar repo (lihat README) karena isinya 29 MB, sembilan kali
# lipat seluruh kode aplikasi, sementara tidak satu pun dirujuk kodenya.
# Arsip deploy ikut mengecil dari 28 MB menjadi seukuran kodenya saja.
dokumentasi/
*.docx

# OS
.DS_Store
Thumbs.db
sertifikat/
