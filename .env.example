# SIGAP - Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# ── WhatsApp Engineer per divisi ──────────────────────────────────────
# Format: kode negara tanpa tanda '+' dan tanpa spasi. Contoh 081234567890
# ditulis 6281234567890. Tanda hubung/spasi otomatis dibersihkan server.
#
# Nomor cadangan bila nomor divisi belum diisi — eskalasi tetap terkirim
# ke sini agar pengaduan tidak buntu.
WHATSAPP_DEFAULT=6281234567890

# Isi masing-masing dengan nomor engineer penanggung jawab divisi tersebut.
WHATSAPP_PRINTER=
WHATSAPP_CCTV=
WHATSAPP_TELEPON=
WHATSAPP_RADIO=
WHATSAPP_WINDOWS=
WHATSAPP_FTTH=
WHATSAPP_LAN=
WHATSAPP_WAN=

# ── Basis data ────────────────────────────────────────────────────────
# Berkas SQLite. Memuat nama pegawai asli — jangan diunggah ke repositori.
DB_PATH=./data/sigap.db

# ── Halaman rekap ─────────────────────────────────────────────────────
# Kunci penanda tangan sesi masuk. WAJIB diisi di lingkungan nyata:
# bila kosong, server memakai kunci acak baru setiap kali dijalankan dan
# semua pengguna terpaksa masuk ulang.
# Buat kunci acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Isi 1 bila aplikasi disajikan lewat HTTPS, agar kuki sesi hanya
# dikirim melalui koneksi terenkripsi.
COOKIE_SECURE=0

# Batas diam sebelum sebuah sesi percakapan dianggap ditinggalkan (menit).
MENIT_SESI_TERBENGKALAI=30

# Isi 1 bila aplikasi berada di belakang reverse proxy (nginx, IIS). Tanpa ini
# seluruh permintaan tampak berasal dari alamat proxy, sehingga pembatas laju
# akan menahan semua pengguna sekaligus.
TRUST_PROXY=0

# Alamat yang dapat dibuka dari LUAR mesin ini — dipakai menyusun tautan
# "Tandai Selesai" di dalam pesan WhatsApp kepada engineer.
#
# BOLEH DIKOSONGKAN. Bila kosong, alamat diambil dari peramban pelapor sendiri:
# ia sudah membuka aplikasi ini dari suatu alamat, dan bila ia berada di
# jaringan kantor maka alamat itu justru sudah tepat — engineer berada di
# jaringan yang sama. Pengecualiannya hanya localhost, karena di ponsel
# engineer localhost menunjuk ke ponselnya sendiri; dalam hal itu tautannya
# tidak disertakan sama sekali.
#
# Isi variabel ini bila alamatnya memang berbeda dari yang dipakai pelapor —
# misalnya aplikasi berada di belakang reverse proxy dengan nama domain.
#
# Contoh:
#   ALAMAT_PUBLIK=https://sigap.lirik.pertamina.id
#   ALAMAT_PUBLIK=http://192.168.1.50:3000
ALAMAT_PUBLIK=

# ── Pemeliharaan otomatis ─────────────────────────────────────────────
# Cadangan harian disimpan di <folder DB>/cadangan, log di <folder DB>/log.
# Keduanya memuat data pegawai — jangan diunggah ke repositori.
HARI_SIMPAN_CADANGAN=14
HARI_SIMPAN_LOG=30

# WAJIB DIISI untuk pemakaian nyata. Cadangan di folder DB berada pada disk
# yang SAMA dengan basis datanya: bila disk itu rusak, keduanya hilang
# bersamaan. Isi dengan folder di luar mesin ini.
#
# Contoh:
#   CADANGAN_LUAR=\\server-file\backup\sigap
#   CADANGAN_LUAR=C:\Users\ict\OneDrive\Cadangan SIGAP
#   CADANGAN_LUAR=E:\cadangan-sigap
#
# Bila tujuannya sedang tidak terhubung, server tetap berjalan dan hanya
# mencatat peringatan.
CADANGAN_LUAR=

# Berapa hari kegagalan cadangan luar dibiarkan sebelum diperingatkan keras.
HARI_PERINGATAN_CADANGAN_LUAR=3

# Setelah sekian tahun, nama pelapor dikosongkan sedangkan barisnya tetap
# disimpan untuk perbandingan tren antar tahun (lihat RANCANGAN-DATA.md §11).
TAHUN_RETENSI=2

# ── Penyunting SOP (/sop-editor) ──────────────────────────────────────
# Sebelum berkas SOP ditimpa, salinannya disimpan di <folder DB>/cadangan-sop
# dengan cap waktu sampai ke detik. Berbeda dengan cadangan basis data yang
# cukup satu potret per hari, SOP dapat disunting beberapa kali dalam sehari —
# dan justru suntingan berikutnya pada hari yang sama yang paling sering ingin
# dibatalkan. Nilai di bawah adalah banyaknya salinan yang disimpan per berkas.
JUMLAH_CADANGAN_SOP=20
