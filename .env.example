# AI Helpdesk ICT - Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# NVIDIA NIM (endpoint OpenAI-compatible)
# Dapatkan API key di https://build.nvidia.com — jangan pernah commit key asli.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model chat.
# Catatan hasil pengujian pada tier gratis:
#  - Semua varian 70B dense (llama-3.3-70b, llama-3.1-70b) menggantung tanpa
#    pernah membalas, jadi JANGAN dipakai sebagai model utama.
#  - Model bertipe reasoning (nemotron) mengisi `reasoning_content`, bukan
#    `delta.content`, sehingga jawabannya terbaca kosong.
# Bila model utama diam, kode otomatis mengulang ke NVIDIA_FALLBACK_MODEL.
NVIDIA_CHAT_MODEL=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT_MS=45000

# Model embedding — menghasilkan vektor 1024 dimensi.
# Mengganti model ini WAJIB diikuti `npm run ingest` ulang, karena vektor
# lama dengan dimensi berbeda tidak dapat dibandingkan.
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ── WhatsApp Engineer per divisi ──────────────────────────────────────
# Format: kode negara tanpa tanda '+' dan tanpa spasi. Contoh 081234567890
# ditulis 6281234567890. Tanda hubung/spasi otomatis dibersihkan server.
#
# Nomor cadangan bila nomor divisi belum diisi — eskalasi tetap terkirim
# ke sini agar pengaduan tidak buntu.
WHATSAPP_DEFAULT=6281234567890

# Isi masing-masing dengan nomor engineer penanggung jawab divisi tersebut.
WHATSAPP_PRINTER=
WHATSAPP_CCTV=
WHATSAPP_TELEPON=
WHATSAPP_RADIO=
WHATSAPP_WINDOWS=
WHATSAPP_FTTP=
WHATSAPP_LAN=
WHATSAPP_WAN=

# Database
DB_PATH=./data/helpdesk.db
