# SIGAP AI - Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# ── Penyedia UTAMA: NVIDIA (layanan awan) ────────────────────────────
# Lebih cepat (sekitar 3-5 detik) dan mutu jawabannya lebih baik.
# Dapatkan API key gratis di https://build.nvidia.com
# JANGAN pernah commit key asli ke repositori.
#
# Catatan: katalog model NVIDIA berubah sewaktu-waktu. Bila muncul galat
# 410 "end of life", pilih model lain dari https://build.nvidia.com
PRIMARY_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PRIMARY_CHAT_MODEL=meta/llama-3.1-8b-instruct
PRIMARY_TIMEOUT_MS=60000
PRIMARY_MAX_TOKENS=1500

# ── Penyedia CADANGAN: Ollama di komputer sendiri ────────────────────
# Dipakai otomatis bila internet mati atau layanan awan bermasalah,
# sehingga layanan pengaduan tetap dapat berjalan.
#
# Prasyarat:
#   1. Pasang Ollama dari https://ollama.com/download
#   2. ollama pull qwen2.5:7b     (ringan: qwen2.5:3b)
FALLBACK_BASE_URL=http://localhost:11434/v1
FALLBACK_CHAT_MODEL=qwen2.5:7b
FALLBACK_TIMEOUT_MS=180000
FALLBACK_MAX_TOKENS=1500

# ── Embedding: SELALU lokal, tidak boleh berganti penyedia ───────────
# Vektor pada basis data dibuat oleh model ini. Mengganti model membuat
# hasil pencarian kacau TANPA memunculkan galat, dan WAJIB diikuti:
#   npm run ingest -- --clear --ingest
#
# Prasyarat: ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBED_MODEL=bge-m3

# ── WhatsApp Engineer per divisi ──────────────────────────────────────
# Format: kode negara tanpa tanda '+' dan tanpa spasi. Contoh 081234567890
# ditulis 6281234567890. Tanda hubung/spasi otomatis dibersihkan server.
#
# Nomor cadangan bila nomor divisi belum diisi — eskalasi tetap terkirim
# ke sini agar pengaduan tidak buntu.
WHATSAPP_DEFAULT=6281234567890

# Isi masing-masing dengan nomor engineer penanggung jawab divisi tersebut.
WHATSAPP_PRINTER=
WHATSAPP_CCTV=
WHATSAPP_TELEPON=
WHATSAPP_RADIO=
WHATSAPP_WINDOWS=
WHATSAPP_FTTP=
WHATSAPP_LAN=
WHATSAPP_WAN=

# Database
DB_PATH=./data/helpdesk.db
